# ============================================================
# Copy this file to `.env` and fill in your values.
# The scripts read it automatically (python-dotenv).
# ============================================================

# --- Webasyst / Shop-Script ---------------------------------
# Base URL of your shop (no trailing slash).
WEBASYST_BASE_URL=https://your-shop.example.com
# OAuth access token (see README → "Getting a Webasyst API token").
WEBASYST_TOKEN=your_access_token_here
# Arbitrary client id used in the OAuth authorize URL (for your records).
WEBASYST_CLIENT_ID=ai_rewriter

# --- LLM (any OpenAI-compatible endpoint) -------------------
# OpenAI, DeepSeek, OpenRouter, local Ollama, etc.
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# Local Ollama example (uncomment):
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# --- Scanner / pipeline tuning ------------------------------
# How many products to scan (0 = the whole sitemap).
SCAN_LIMIT=0
# Parallel downloads during the scan.
SCAN_WORKERS=8
# How many products to process per pipeline run.
BATCH_SIZE=50
# Pause between products, seconds.
DELAY_SECONDS=2
# CSS classes that mark an already-rewritten ("new format") description.
NEW_MARKERS=faq-item,facts-wrapper
